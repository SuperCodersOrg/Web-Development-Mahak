<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>

    <form action="/multiple" method="post" enctype="multipart/form-data">
        <input type="text" name="username">
        <input type="file" name="imageFile" multiple><br><br>
        <button type="submit">Submit Your Data!</button>
    </form>

    <% uploadedfile.forEach((elem)=>{ %>
        <img src="/userFiles/<%= elem.filename %>" alt="This is an image you have selected">
        <% }) %>

</body>

</html>